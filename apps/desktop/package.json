{
  "name": "@egohygiene/antidote-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.19.x"
  },
  "scripts": {
    "build": "tsc --build && vite build",
    "dev": "vite",
    "format": "prettier --write \"src/**/*.{css,ts,tsx}\" \"*.{html,json,mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{css,ts,tsx}\" \"*.{html,json,mjs,ts}\"",
    "lint": "eslint . --max-warnings=0",
    "tauri": "tauri",
    "test": "vitest run",
    "test:contracts": "vitest run src/contracts.test.ts",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
