  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.19.x"
  },
  "scripts": {
    "build": "pnpm --filter @egohygiene/antidote-desktop build",
