{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:antidote:schema:working-context-projection:v1",
  "title": "Antidote Working Context Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "consent_grant_ids",
    "created_at",
    "derivation_version",
    "source_event_ids",
    "semantic_items"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "consent_grant_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "derivation_version": { "type": "string", "minLength": 1 },
    "source_event_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "semantic_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "text", "source_event_ids", "user_review"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "type": "string",
            "enum": ["state", "meaning", "metaphor", "memory", "preference", "inclusion", "exclusion", "constraint", "uncertainty"]
          },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "source_event_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "user_review": {
            "type": "string",
            "enum": ["pending", "approved", "edited", "excluded"]
          }
        }
      }
    },
    "projection_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
