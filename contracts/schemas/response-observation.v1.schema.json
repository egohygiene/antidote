{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:antidote:schema:response-observation:v1",
  "title": "Antidote Response Observation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "exposure_id",
    "observed_at",
    "window",
    "felt_state",
    "wanted_intensity",
    "helpfulness",
    "resonance",
    "mismatch",
    "harm"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "exposure_id": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "window": {
      "type": "string",
      "enum": ["during", "immediate", "later"]
    },
    "instrument_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "perceived_expression": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "valence": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "arousal": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "intensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "felt_state": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "valence": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "arousal": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "intensity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
      }
    },
    "wanted_intensity": { "type": ["boolean", "null"] },
    "helpfulness": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "resonance": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "mismatch": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "harm": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "surprise": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "interaction_burden": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "session_burden": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "missing_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "perceived_expression",
          "felt_state",
          "wanted_intensity",
          "helpfulness",
          "resonance",
          "mismatch",
          "harm",
          "surprise",
          "interaction_burden",
          "session_burden"
        ]
      }
    },
    "missingness_reason": {
      "type": "string",
      "enum": [
        "not_prompted",
        "declined",
        "missed_window",
        "technical_failure",
        "interrupted",
        "not_applicable"
      ]
    },
    "stopped_early": { "type": "boolean", "default": false },
    "notes": { "type": "string", "maxLength": 8000 },
    "later_aftereffect_requested": { "type": "boolean", "default": false },
    "allow_personal_model_update": { "type": "boolean", "default": false }
  }
}
