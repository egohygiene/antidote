{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:antidote:schema:generation-result:v1",
  "title": "Antidote Generation Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "generation_spec_id",
    "status",
    "adapter",
    "model",
    "code_revision",
    "device_class",
    "elapsed_ms",
    "artifacts",
    "warnings"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "generation_spec_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["generated", "partial", "cancelled", "failed"]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "code_revision": { "type": "string", "minLength": 1 },
    "device_class": { "type": "string", "minLength": 1 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "effective_parameters": { "type": "object" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256", "media_type", "size_bytes"],
        "properties": {
          "kind": { "type": "string", "enum": ["audio", "preview", "feature_report", "log"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "media_type": { "type": "string", "minLength": 1 },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "feature_report": {
      "type": ["object", "null"],
      "properties": {
        "duration_seconds": { "type": "number", "minimum": 0 },
        "tempo_bpm": { "type": ["number", "null"], "minimum": 0 },
        "key": { "type": ["string", "null"] },
        "loudness_lufs": { "type": ["number", "null"] },
        "control_adherence": { "type": "object" },
        "analyzer_versions": { "type": "object" }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 2000 }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
