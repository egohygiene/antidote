{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egohygiene:antidote:schema:journey-plan:v1",
  "title": "Antidote Journey Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "session_id",
    "moment_context_id",
    "status",
    "strategy",
    "total_duration_seconds",
    "stages",
    "safety_constraints"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "moment_context_id": { "type": "string", "minLength": 1 },
    "working_projection_id": { "type": ["string", "null"] },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "superseded"]
    },
    "strategy": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "total_duration_seconds": { "type": "integer", "minimum": 10, "maximum": 3600 },
    "revision": { "type": "integer", "minimum": 1 },
    "supersedes_plan_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "rule_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "input_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "control_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_controls",
        "stagewise_controls",
        "tempo_bpm_min",
        "tempo_bpm_max",
        "density_ceiling",
        "spatiality_ceiling"
      ],
      "properties": {
        "supported_controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "tempo_bpm",
              "key",
              "time_signature",
              "timbre",
              "harmony",
              "density",
              "spatiality",
              "dynamics"
            ]
          }
        },
        "stagewise_controls": { "type": "boolean" },
        "tempo_bpm_min": { "type": "number", "minimum": 20, "maximum": 300 },
        "tempo_bpm_max": { "type": "number", "minimum": 20, "maximum": 300 },
        "density_ceiling": { "type": "number", "minimum": 0, "maximum": 1 },
        "spatiality_ceiling": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "role", "duration_seconds", "semantic_intent", "acoustic_controls"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "role": {
            "type": "string",
            "enum": ["meet", "hold", "transition", "release", "integrate", "close", "other"]
          },
          "duration_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
          "semantic_intent": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1, "maxLength": 500 }
          },
          "acoustic_controls": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "tempo_bpm": { "type": ["number", "null"], "minimum": 20, "maximum": 300 },
              "key": { "type": ["string", "null"], "maxLength": 32 },
              "time_signature": { "type": ["string", "null"], "pattern": "^[1-9][0-9]*/[1-9][0-9]*$" },
              "timbre": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
              "harmony": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
              "density": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "spatiality": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
              "dynamics": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
            }
          },
          "transition_rationale": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "safety_constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "derivations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "source", "rule_id", "rationale", "uncertainty"],
        "properties": {
          "target": { "type": "string", "pattern": "^/", "maxLength": 300 },
          "source": { "type": "string", "enum": ["rule", "person_edit"] },
          "rule_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "uncertainty": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
